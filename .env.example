# ── Servidor SQL donde están el ERP ICG y la base de fabricación ──
FAB_HOST=127.0.0.1
FAB_PORT=1433
FAB_USER=sa
FAB_PASS=

# Base de fabricación: la app la crea sola si no existe (el usuario necesita permiso para crear bases)
FAB_DB=FABRICACION

# Base del ERP ICG con ARTICULOS, KITS, FAMILIAS, STOCKS, ALMACEN...
FAB_LOCO_DB=

# Base con la tabla USUARIOS de ICG (normalmente GENERAL)
FAB_USUARIOS_DB=GENERAL

# CODUSUARIO de ICG que entran siempre como administrador (separados por coma)
FAB_ADMINS=

# Puerto web de la app
PORT=3000

# Opcional: clave para firmar sesiones. Si se deja vacía se genera en el archivo .fab_secret
FAB_SECRET=
